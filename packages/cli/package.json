{
  "name": "sentinel0",
  "version": "0.0.2",
  "description": "Trigger Hermes agents from your tickets and pull requests.",
  "type": "module",
  "keywords": [
    "ai",
    "cli",
    "agents",
    "hermes",
    "orchestrator",
    "linear",
    "github",
    "automation",
    "sentinel0"
  ],
  "bin": {
    "sentinel0": "dist/cli/src/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli/src/index.js",
    "lint": "eslint src test scripts vitest.config.ts",
    "lint:fix": "eslint src test scripts vitest.config.ts --fix",
    "prepack": "node ./scripts/prepare-package.mjs",
    "postpack": "node ./scripts/restore-workspace-links.mjs",
    "pack:check": "npm_config_cache=.npm-cache npm pack --dry-run",
    "pack:tarball": "npm_config_cache=.npm-cache npm pack",
    "publish:package": "npm_config_cache=.npm-cache npm publish --access public",
    "start": "tsx src/index.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@clack/prompts": "1.4.0",
    "@fastify/cors": "11.2.0",
    "@sentinel0/common": "0.0.2",
    "@sentinel0/orchestrator": "0.0.2",
    "chalk": "4",
    "fastify": "5.7.4",
    "p-limit": "6.1.0",
    "strip-ansi": "7.1.2"
  },
  "bundleDependencies": [
    "@sentinel0/common",
    "@sentinel0/orchestrator"
  ],
  "devDependencies": {
    "@types/node": "25.3.0",
    "tsx": "4.19.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "url": "https://github.com/maxigimenez/sentinel0"
  }
}
