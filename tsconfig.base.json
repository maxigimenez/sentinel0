{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@sentinel0/common": [
        "packages/common/src/index.ts"
      ],
      "@sentinel0/common/executor": [
        "packages/common/src/executor.ts"
      ],
      "@sentinel0/common/github": [
        "packages/common/src/github.ts"
      ],
      "@sentinel0/orchestrator": [
        "packages/orchestrator/src/index.ts"
      ],
      "@sentinel0/cloud-api": [
        "packages/cloud-api/src/index.ts"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true
  }
}
